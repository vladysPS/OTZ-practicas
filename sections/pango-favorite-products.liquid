<!-- pango-favorite-products.liquid -->

<section class="p-{{ section.id }}">
  <div class="page-width">
    <div class="pango-favorites__grid" id="pango-favorites-grid"></div>
    <p id="pango-favorites-empty" style="display:none;">No favourite products yet.</p>
  </div>
</section>

<style>
.p-{{ section.id }} {
  padding: 40px 0;
}

.pango-favorites__grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20px;
}

@media (min-width: 768px) {
  .pango-favorites__grid {
    grid-template-columns: repeat(4, 1fr);
  }
}

.pango-fav-card {
  display: flex;
  flex-direction: column;
  border: 1px solid #e0e0e0;
  border-radius: 8px;
  overflow: hidden;
  text-decoration: none;
  color: inherit;
}

.pango-fav-card img {
  aspect-ratio: 1;
  object-fit: cover;
  width: 100%;
  display: block;
}

.pango-fav-card__body {
  padding: 12px;
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.pango-fav-card__title {
  font-size: 14px;
  font-weight: 600;
  margin: 0;
}

.pango-fav-card__price {
  font-size: 13px;
  color: #555;
  margin: 0;
}

.pango-fav-card__btn {
  margin-top: auto;
  background: #000;
  color: #fff;
  border: none;
  padding: 10px;
  cursor: pointer;
  font-size: 13px;
  border-radius: 4px;
  width: 100%;
  text-align: center;
}

.pango-fav-card__btn:hover {
  background: #333;
}
</style>

<script>
(function () {
  const grid = document.getElementById('pango-favorites-grid');
  const emptyMsg = document.getElementById('pango-favorites-empty');

  let favorites = [];
  try { favorites = JSON.parse(localStorage.getItem('favoriteProducts')) || []; } catch (e) {}

  if (!favorites.length) {
    emptyMsg.style.display = 'block';
    return;
  }
  await Promise.all( favorites.map(async (handle) => {
    const response = await fetch(`/products/${handle}.js`);
    console.log("this is RES when requesting the api", response );
    if (!response.ok) return;
    const product = await response.json();
    console.log("this is P filtered with .json after await", product);

    const price = (product.variants[0].price / 100).toLocaleString('en-US', {
      style: 'currency',
      currency: '{{ cart.currency.iso_code }}'
    });

    const card = document.createElement('a');
    card.className = 'pango-fav-card';
    card.href = `/products/${product.handle}`;
    card.innerHTML = `
      ${product.images[0]
        ? `<img src="${product.images[0]}" alt="${product.title}" loading="lazy">`
        : `<div style="aspect-ratio:1;background:#f4f4f4;display:flex;align-items:center;justify-content:center;color:#aaa;font-size:13px;">No image</div>`
      }
      <div class="pango-fav-card__body">
        <p class="pango-fav-card__title">${product.title}</p>
        <p class="pango-fav-card__price">${price}</p>
        <span class="pango-fav-card__btn">View product</span>
      </div>
    `;

    grid.appendChild(card);
  }));

})();
</script>

{% schema %}
{
  "name": "Pango Favorite Products",
  "settings": [],
  "presets": [{ "name": "Pango Favorite Products", "category": "All Pango" }]
}
{% endschema %}
